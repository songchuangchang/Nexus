<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络访问权限（核心！没有这个 App 无法连接 API）-->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 写入外部存储（用于日志导出分享 + v1.4.2 通用文件下载）-->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- v1.4.2：Android 13+ 通用文件下载（视频/图片/文档）-->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- v1.3.6：📎 附件拍照必需 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- v1.3.6：下载 APK 后点"安装"按钮必需（Android 8+ 安装未知来源包要此权限）-->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 通知权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- build142（灵动岛）：前台服务与其类型。
         Android 14+ 要求「服务声明的类型」与「对应的 FOREGROUND_SERVICE_* 权限」**成对**存在，
         少一个会在 startForeground 时抛 SecurityException。
         ⚠️ build155 订正注释口径：promoted/Live Updates 那条权限**在下面已经声明了**
         （`POST_PROMOTED_NOTIFICATIONS`，build145 补的）。这一段原本写的是
         「刻意不声明任何 promoted 权限」，与下面第 40 行直接矛盾 ——
         留着它，下一个人照注释把那条权限删掉，岛就又没了（同一个坑踩过两次）。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- build145 修正：这一条我上一批**故意漏掉了**，理由是「本地 android-36 的
         `Manifest.permission` 里搜不到这个常量」——那个判断方法是错的：清单里的权限是
         **字符串**，不需要有 Java 常量也能声明（Google 给 16 的新权限常有这种时间差）。
         官方「创建实时更新通知」原文：「必须在 Android 清单文件中请求以下非运行时权限：
         android.permission.POST_PROMOTED_NOTIFICATIONS」（normal 权限，不用运行时申请）。
         真机实证正好对上：`canPostPromotedNotifications()=false` 而 `promotable=true`
         ⇒ 通知本身够格，是**没声明权限**导致系统不给这个应用发布实时活动的资格，
         于是 ColorOS 的「流体云显示实时活动」名单里连 Nexus 这一行都没有。 -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- 生物识别锁（local_auth）：API 28+ 用 USE_BIOMETRIC，API <28 需 USE_FINGERPRINT -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <!-- v1.7.50 build106：设备定位（get_location 内置工具，geolocator） -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:label="Nexus"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- build123：接收其他 App「分享到 Nexus」。
                 launchMode 由 singleTop 改 singleTask —— 分享来自别的 App 的任务栈，
                 singleTop 无法保证复用已有实例（会另起一个），onNewIntent 不触发，
                 分享内容就落不到已打开的会话里。 -->
            <!-- 文本 / 网址（微信、浏览器、记事本等分享纯文本走这里） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <!-- 单个文件（文档 / 图片 / 音视频等任意类型） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
            <!-- 多选文件（只取第一个，其余数量如实告知用户） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
        </activity>
        <!-- build142（灵动岛）：两个前台服务，**故意不合并**。
             下载/备份属 dataSync（有「用户主动发起」与 Android 15 起约 6 小时/日配额），
             AI 长轮语义上不属于任何既有类型 ⇒ specialUse，需要在商店写用途说明。
             合并等于把两类合规风险叠在一起，还会让长任务吃掉下载的配额。 -->
        <service
            android:name=".LiveDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".LiveAgentService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- Android 14 起 specialUse 要求自述用途（商店审核会读这一段）。 -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Deep-research / agent tool-loop rounds and remote video-generation polling started explicitly by the user; the notification shows round progress and the run ends within the app's own round cap." />
        </service>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- v1.3.6：安装 APK（Android 11+ 包可见性，不声明则 resolveActivity 返回 null）-->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="application/vnd.android.package-archive"/>
        </intent>
        <!-- v1.3.6：打开文件/文件夹（content:// 和 file:// scheme）-->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="content"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="file"/>
        </intent>
        <!-- v1.7.50 build106（U5）：AI 回答里的地图深链唤起（Android 11+ 包可见性）-->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="amapuri"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="androidamap"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="geo"/>
        </intent>
    </queries>
</manifest>
