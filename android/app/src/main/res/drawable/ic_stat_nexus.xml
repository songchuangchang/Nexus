        android:fillType="evenOdd"
        android:pathData="M7,3 h10 a3,3 0 0 1 3,3 v7 a3,3 0 0 1 -3,3 h-5.5 l-4.5,4 v-4 a3,3 0 0 1 -3,-3 v-7 a3,3 0 0 1 3,-3 z M7.2,10.5 a1.3,1.3 0 1 0 2.6,0 a1.3,1.3 0 1 0 -2.6,0 z M10.7,10.5 a1.3,1.3 0 1 0 2.6,0 a1.3,1.3 0 1 0 -2.6,0 z M14.2,10.5 a1.3,1.3 0 1 0 2.6,0 a1.3,1.3 0 1 0 -2.6,0 z" />
</vector>
